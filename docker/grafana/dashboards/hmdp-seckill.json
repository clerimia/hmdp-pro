{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "秒杀进入 QPS（按方案）",
      "description": "限流之前计数，反映真实流量而不是被限流后的流量，两者相除即被限流比例",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_seckill_request_total[1m])) by (mode)",
          "legendFormat": "mode={{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "秒杀成功率",
      "description": "分母用 clamp_min 兜底，无流量时不会出现除零导致的断线",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_seckill_result_total{result=\"success\"}[1m])) / clamp_min(sum(rate(hmdp_seckill_result_total[1m])), 0.0001)",
          "legendFormat": "成功率",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "秒杀结果分布（按 reason）",
      "description": "stock_out / repeat / mq_send_error / system_error / rate_limited；reason 取值封闭在 SeckillMetrics.Reason 枚举里",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_seckill_result_total[1m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 40, "stacking": { "mode": "normal" }, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "秒杀耗时 P95（按方案）",
      "description": "Timer 名不要手写 _seconds，Micrometer 会自动转换，否则暴露成 ..._seconds_seconds",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "histogram_quantile(0.95, sum(rate(hmdp_seckill_latency_seconds_bucket[1m])) by (le, mode))",
          "legendFormat": "P95 mode={{mode}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "histogram_quantile(0.5, sum(rate(hmdp_seckill_latency_seconds_bucket[1m])) by (le, mode))",
          "legendFormat": "P50 mode={{mode}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "限流：被拦截 vs 组件兜底（fail-open）",
      "description": "fallback 上涨说明限流组件自身不可用，此时全量放行 —— 业务层（库存/一人一单）仍然 fail-closed",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_seckill_result_total{reason=\"rate_limited\"}[1m]))",
          "legendFormat": "被限流拦截",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_ratelimit_fallback_total[1m])) by (strategy)",
          "legendFormat": "兜底 strategy={{strategy}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "right" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "MQ 消费结果（按 tag / result）",
      "description": "tag=CREATE（领券落库）；error 持续上涨要查消费者",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_order_consume_total[1m])) by (tag, result)",
          "legendFormat": "{{tag}}/{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "缓存命中层级分布",
      "description": "l1=Caffeine / l2=Redis / db=回源；l1 占比下降通常意味着本地缓存被驱逐或实例刚重启",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_cache_hit_total[1m])) by (level)",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 40, "stacking": { "mode": "normal" }, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "缓存异步重建结果",
      "description": "error 持续上涨 = 缓存长期刷不动，属于被线程池静默吞掉的静默故障，靠这个指标才能发现",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(rate(hmdp_cache_rebuild_total[1m])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "熔断状态（OPEN / HALF_OPEN 翻转）",
      "description": "resilience4j-micrometer 自动上报的熔断状态 Gauge：state=open / half_open = 1 表示正在降级；闭合时应只有 closed=1",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "max by (name, state) (resilience4j_circuitbreaker_state)",
          "legendFormat": "{{name}} state={{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "熔断事件（每分钟，按 breaker/kind）",
      "description": "kind=error 是学习窗口内的真实依赖失败；kind=not_permitted 是熔断打开后被快速打回的调用，即降级拒流量",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(increase(hmdp_resilience_breaker_event_total[1m])) by (breaker, kind)",
          "legendFormat": "{{breaker}} kind={{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "熔断状态翻转（每分钟，按 breaker/state）",
      "description": "open 翻转说明熔断打开；half_open 表示探测窗口；closed 说明恢复闭合——故障演练时看这条时间线",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(increase(hmdp_resilience_breaker_transition_total[1m])) by (breaker, state)",
          "legendFormat": "{{breaker}} -> {{state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "降级与重试动作（每分钟）",
      "description": "fallback = 降级动作打点（not_permitted=熔断快速失败 / error=学习期失败 / bulkhead_rejected=舱壁打回）；retry = 只读链路重试",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(increase(hmdp_resilience_fallback_total[1m])) by (breaker, kind)",
          "legendFormat": "fallback {{breaker}} kind={{kind}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(increase(hmdp_resilience_retry_total[1m])) by (retry, kind)",
          "legendFormat": "retry {{retry}} kind={{kind}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "秒杀降级量（每分钟，按 breaker/reason）",
      "description": "降级量混入 SeckillMetrics 的 reason 体系：db_degraded（dbBreaker 打开，返回「下单处理中」）/ mq_send_error（mqBreaker 打开，下单快速失败），与秒杀结果分布面板同口径互相印证",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "hmdp-prom" },
          "expr": "sum(increase(hmdp_seckill_degraded_total[1m])) by (breaker, reason)",
          "legendFormat": "{{breaker}} reason={{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    }

  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["hmdp", "seckill", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "hmdp-pro 秒杀可观测",
  "uid": "hmdp-seckill",
  "version": 1,
  "weekStart": ""
}
